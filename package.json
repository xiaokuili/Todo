{
  "name": "global-todo",
  "version": "1.0.0",
  "description": "A simple global todo list with CLI and Git sync",
  "main": "index.js",
  "bin": {
    "todo": "./bin/todo.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "web": "concurrently \"npm run dev\" \"npm start\"",
    "format": "prettier --write \"public/**/*.{js,html,css,jsx}\"",
    "lint": "eslint public/js --fix"
  },
  "keywords": ["todo", "cli", "task"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "prettier": "^3.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0"
  }
}
